    "@tauri-apps/api": "^2.12.1",
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  }
}
