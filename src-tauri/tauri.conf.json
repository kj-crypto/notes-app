{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "notes-app",
  "version": "0.1.0",
  "identifier": "notes-app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "notes-app",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 700,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "files": {
          "usr/lib/x86_64-linux-gnu/gio/modules/libgvfsdbus.so": "/usr/lib/x86_64-linux-gnu/gio/modules/libgvfsdbus.so"
        }
      }
    }
  }
}
